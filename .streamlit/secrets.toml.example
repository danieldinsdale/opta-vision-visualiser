# Copy to secrets.toml (git-ignored) and fill in. Read by the local server (`npm start` in web/)
# only; the key never reaches the browser. The SDAPI option appears once API_OUTLET_KEY is set.

# API_OUTLET_KEY = "<your outlet key>"

# Only if the API answers HTTP 403 (some accounts need a Referer header):
# API_REFERER = "www.performfeeds.com"
